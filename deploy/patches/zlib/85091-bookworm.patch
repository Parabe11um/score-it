Description: Reset pending input state on failed direct gzwrite (CVE-2026-85091)
Origin: backport, https://github.com/madler/zlib/commit/df84af25dc1942490e1d1c899a07619152a46148
Applied-to: Debian Bookworm zlib 1.2.13
--- a/gzwrite.c
+++ b/gzwrite.c
@@ -241,8 +241,11 @@
                 n = (unsigned)len;
             state->strm.avail_in = n;
             state->x.pos += n;
-            if (gz_comp(state, Z_NO_FLUSH) == -1)
+            if (gz_comp(state, Z_NO_FLUSH) == -1) {
+                state->strm.avail_in = 0;
+                state->strm.next_in = state->in;
                 return 0;
+            }
             len -= n;
         } while (len);
     }
