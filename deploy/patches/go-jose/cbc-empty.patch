From 35883f7999e87cbd1b1f4cda07fdad8cd71c3dd6
Subject: cipher/cbc_hmac: don't panic on empty ciphertext

diff --git a/cipher/cbc_hmac.go b/cipher/cbc_hmac.go
--- a/cipher/cbc_hmac.go
+++ b/cipher/cbc_hmac.go
@@ -176,7 +176,9 @@ func padBuffer(buffer []byte, blockSize int) []byte {
 
 // Remove padding
 func unpadBuffer(buffer []byte, blockSize int) ([]byte, error) {
-	if len(buffer)%blockSize != 0 {
+	// A padded buffer can't be empty because an empty input is padded with
+	// `blockSize` bytes, resulting in a non-empty ciphertext.
+	if len(buffer) == 0 || len(buffer)%blockSize != 0 {
 		return nil, errors.New("go-jose/go-jose: invalid padding")
 	}
 
