Description: Backport the width guard to all four Pod::Text formatters in Perl 5.36.
Origin: https://github.com/rra/podlators/commit/70510174f69eb54aa6d617bde4e1402cd9b7c61f
Forwarded: not-needed

--- a/cpan/podlators/lib/Pod/Text.pm
+++ b/cpan/podlators/lib/Pod/Text.pm
@@ -238,6 +238,15 @@
     my $output = '';
     my $spaces = ' ' x $$self{MARGIN};
     my $width = $$self{opt_width} - $$self{MARGIN};
+
+    # Upstream 7051017: a nonpositive effective width makes the wrapping
+    # expression match an empty string forever. Report it and omit padding.
+    if ($width <= 0) {
+        my $error = 'Margin is wider than the output width';
+        $self->whine($self->line_count(), $error);
+        $spaces = q{};
+        $width = $self->{opt_width};
+    }
     while (length > $width) {
         if (s/^([^\n]{0,$width})[ \t\n]+// || s/^([^\n]{$width})//) {
             $output .= $spaces . $1 . "\n";
