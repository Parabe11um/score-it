ARG POSTGRES_IMAGE=postgres:17.11-bookworm@sha256:3645570cccdfa447589da9f57dd740faa29b30938e861289a5574b6ca6b03826
ARG GO_IMAGE=golang:1.26.10-alpine3.24@sha256:9ce231b28998b32e116927c61aa5c406183061d4f3f2d61b292c88e7f6bdf7ca
FROM ${POSTGRES_IMAGE} AS tools-builder
ARG BUILD_TLS_COMPAT=0
RUN --mount=type=bind,source=deploy/build_tls.sh,target=/run/score-it-build-tls.sh,readonly \
    --mount=type=bind,source=deploy/build_runtime_noacl.sh,target=/run/score-it-build-noacl.sh,readonly \
    --mount=type=bind,source=deploy/acl_tools_sources.sha256,target=/run/score-it-acl-sources.sha256,readonly \
    --mount=type=bind,source=deploy/runtime_tools_probe.sh,target=/run/score-it-noacl-probe.sh,readonly \
    sh /run/score-it-build-tls.sh "$BUILD_TLS_COMPAT" sh /run/score-it-build-noacl.sh

FROM ${POSTGRES_IMAGE} AS perl-builder
ARG BUILD_TLS_COMPAT=0
RUN --mount=type=bind,source=deploy/build_tls.sh,target=/run/score-it-build-tls.sh,readonly \
    --mount=type=bind,source=deploy/build_perl_security.sh,target=/run/score-it-build-perl.sh,readonly \
    --mount=type=bind,source=deploy/patches/perl,target=/run/score-it-perl-patches,readonly \
    --mount=type=bind,source=deploy/perl_security_probe.pl,target=/run/score-it-perl-probe.pl,readonly \
    --mount=type=bind,source=deploy/perl_regex_build.sh,target=/run/score-it-perl-regex-build.sh,readonly \
    --mount=type=bind,source=deploy/perl_regex_cache_probe.py,target=/run/score-it-perl-regex-cache.py,readonly \
    --mount=type=bind,source=deploy/perl_regex_runtime_probe.pl,target=/run/score-it-perl-regex-runtime.pl,readonly \
    --mount=type=bind,source=deploy/perl_regex_sources.json,target=/run/score-it-perl-regex-sources.json,readonly \
    sh /run/score-it-build-tls.sh "$BUILD_TLS_COMPAT" sh /run/score-it-build-perl.sh

FROM ${POSTGRES_IMAGE} AS gzip-builder
ARG BUILD_TLS_COMPAT=0
RUN --mount=type=bind,source=deploy/build_tls.sh,target=/run/score-it-build-tls.sh,readonly \
    --mount=type=bind,source=deploy/build_gzip_security.sh,target=/run/score-it-build-gzip.sh,readonly \
    --mount=type=bind,source=deploy/patches/gzip/e7378c2-lzh-state.patch,target=/run/score-it-gzip-followup.patch,readonly \
    --mount=type=bind,source=deploy/gzip_lzh_state_probe.c,target=/run/score-it-gzip-probe.c,readonly \
    sh /run/score-it-build-tls.sh "$BUILD_TLS_COMPAT" sh /run/score-it-build-gzip.sh

FROM ${GO_IMAGE} AS gosu-builder
ARG BUILD_TLS_COMPAT=0
ENV GOTOOLCHAIN=local CGO_ENABLED=0
RUN --mount=type=bind,source=deploy/build_tls.sh,target=/run/score-it-build-tls.sh,readonly \
    sh /run/score-it-build-tls.sh "$BUILD_TLS_COMPAT" apk add --no-cache git
WORKDIR /src
RUN --mount=type=bind,source=deploy/build_tls.sh,target=/run/score-it-build-tls.sh,readonly \
    sh /run/score-it-build-tls.sh "$BUILD_TLS_COMPAT" sh -ec '\
    git init \
    && git remote add origin https://github.com/tianon/gosu.git \
    && git fetch --depth 1 origin 6456aaa0f3c854d199d0f037f068eb97515b7513 \
    && git checkout --detach FETCH_HEAD \
    && go get github.com/moby/sys/user@v0.4.1 golang.org/x/sys@v0.48.0 \
    && go mod verify \
    && go build -trimpath -ldflags "-d -w" -o /out/gosu . \
    && go version -m /out/gosu'

FROM ${POSTGRES_IMAGE} AS postgres-build-deps
ARG BUILD_TLS_COMPAT=0
RUN --mount=type=bind,source=deploy/build_tls.sh,target=/run/score-it-build-tls.sh,readonly \
    sh /run/score-it-build-tls.sh "$BUILD_TLS_COMPAT" sh -ec '\
    apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates curl dpkg-dev \
    && sed "s/^deb /deb-src /" /etc/apt/sources.list.d/pgdg.list >/etc/apt/sources.list.d/score-it-build-src.list \
    && apt-get update \
    && apt-get build-dep -y --no-install-recommends --arch-only \
       --build-profiles=pkg.postgresql.nollvm,nodoc,nocheck "postgresql-17=$PG_VERSION"'
FROM postgres-build-deps AS postgres-builder
RUN --mount=type=bind,source=deploy/build_tls.sh,target=/run/score-it-build-tls.sh,readonly \
    --mount=type=bind,source=deploy/build_postgres_minimal.sh,target=/run/score-it-build-postgres.sh,readonly \
    sh /run/score-it-build-tls.sh "$BUILD_TLS_COMPAT" sh /run/score-it-build-postgres.sh

FROM postgres-build-deps AS libpq-builder
RUN --mount=type=bind,source=deploy/build_tls.sh,target=/run/score-it-build-tls.sh,readonly \
    sh /run/score-it-build-tls.sh "$BUILD_TLS_COMPAT" sh -ec '\
    apt-cache showsrc postgresql-18 | sed -n "s/^Version: /libpq_source_candidate=/p" \
    && apt-get build-dep -y --no-install-recommends --arch-only \
      --build-profiles=pkg.postgresql.nollvm,nodoc,nocheck "postgresql-18=18.6-1.pgdg12+2"'
RUN --mount=type=bind,source=deploy/build_tls.sh,target=/run/score-it-build-tls.sh,readonly \
    --mount=type=bind,source=deploy/build_libpq_minimal.sh,target=/run/score-it-build-libpq.sh,readonly \
    sh /run/score-it-build-tls.sh "$BUILD_TLS_COMPAT" sh /run/score-it-build-libpq.sh

FROM ${POSTGRES_IMAGE} AS runtime-files
ARG BUILD_TLS_COMPAT=0
RUN --mount=type=bind,source=deploy/build_tls.sh,target=/run/score-it-build-tls.sh,readonly \
    --mount=type=bind,source=deploy/update_postgres_security.sh,target=/run/score-it-update-postgres.sh,readonly \
    sh /run/score-it-build-tls.sh "$BUILD_TLS_COMPAT" sh /run/score-it-update-postgres.sh
RUN --mount=type=bind,from=perl-builder,source=/out,target=/run/score-it-perl,readonly \
    dpkg -i /run/score-it-perl/perl-base_5.36.0-7+deb12u4+scoreit2_amd64.deb \
            /run/score-it-perl/perl-modules-5.36_5.36.0-7+deb12u4+scoreit2_all.deb \
            /run/score-it-perl/libperl5.36_5.36.0-7+deb12u4+scoreit2_amd64.deb \
            /run/score-it-perl/perl_5.36.0-7+deb12u4+scoreit2_amd64.deb
RUN --mount=type=bind,from=gzip-builder,source=/out,target=/run/score-it-gzip,readonly \
    dpkg -i /run/score-it-gzip/gzip_1.13-1+deb13u1+scoreit12.1_amd64.deb
RUN --mount=type=bind,from=libpq-builder,source=/out,target=/run/score-it-libpq,readonly \
    dpkg -i /run/score-it-libpq/libpq5_18.6-1.pgdg12+2+scoreit1_amd64.deb
RUN --mount=type=bind,from=postgres-builder,source=/out,target=/run/score-it-postgres,readonly \
    dpkg -i /run/score-it-postgres/postgresql-client-17_17.11-1.pgdg12+2+scoreit2_amd64.deb \
            /run/score-it-postgres/postgresql-17_17.11-1.pgdg12+2+scoreit2_amd64.deb
RUN --mount=type=bind,from=tools-builder,source=/out,target=/run/score-it-tools,readonly \
    dpkg -i /run/score-it-tools/coreutils_9.1-1+~scoreitnoacl1_amd64.deb \
            /run/score-it-tools/sed_4.9-1+deb12u1+~scoreitnoacl1_amd64.deb \
            /run/score-it-tools/tar_1.34+dfsg-1.2+deb12u1+~scoreitnoacl1_amd64.deb
COPY --from=tools-builder /out/acl-tools-*.txt /out/acl-tools-binaries.sha256 /usr/share/score-it/
COPY --from=gosu-builder /out/gosu /usr/local/bin/gosu
RUN gosu --version && gosu postgres id
# Debian's ssl-cert package ships an image-wide test key. PostgreSQL in this
# bundle uses the private backend network with ssl=off, not this certificate.
# Production TLS, when required, must use separately provisioned certificates.
RUN rm -f /etc/ssl/private/ssl-cert-snakeoil.key /etc/ssl/certs/ssl-cert-snakeoil.pem
RUN --mount=type=bind,source=deploy/prune_runtime_sqlite.sh,target=/run/score-it-prune-sqlite.sh,readonly \
    sh /run/score-it-prune-sqlite.sh postgres
RUN --mount=type=bind,source=deploy/prune_postgres_features.sh,target=/run/score-it-prune-features.sh,readonly \
    sh /run/score-it-prune-features.sh
RUN --mount=type=bind,source=deploy/prune_runtime_tools.sh,target=/run/score-it-prune-tools.sh,readonly \
    sh /run/score-it-prune-tools.sh postgres
COPY --from=postgres-builder /out/postgres-*.txt /out/postgres-build-packages.tsv /usr/share/score-it/
COPY --from=libpq-builder /out/libpq-*.txt /usr/share/score-it/
COPY --from=perl-builder /out/perl-regex-build.json /usr/share/score-it/
COPY --from=perl-builder /out/perl-security-source.txt /out/perl-security-tests.txt /out/perl-modules.sha256 /usr/share/score-it/
COPY --from=gzip-builder /out/gzip-*.txt /out/gzip-binary.sha256 /usr/share/score-it/

# Copy the resulting filesystem, not the upstream image's layers: those still
# contain the original gosu and the image-wide test certificate/key.
# OpenSSL uses the pinned Bookworm security update; libc/ICU/locales stay unchanged. The rebuilt
# PostgreSQL package retains Debian's patches, paths and package inventory.
FROM scratch
COPY --from=runtime-files / /
# FROM scratch does not inherit image configuration. Keep these values aligned
# with POSTGRES_IMAGE; check_postgres_runtime.py compares the runtime contract.
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/lib/postgresql/17/bin \
    GOSU_VERSION=1.19 \
    LANG=en_US.utf8 \
    PG_MAJOR=17 \
    PG_VERSION=17.11-1.pgdg12+2+scoreit2 \
    PGDATA=/var/lib/postgresql/data
VOLUME /var/lib/postgresql/data
ENTRYPOINT ["docker-entrypoint.sh"]
STOPSIGNAL SIGINT
EXPOSE 5432
USER 999:999
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=5 \
    CMD pg_isready -h 127.0.0.1 -U "${POSTGRES_USER:-postgres}" -d "${POSTGRES_DB:-${POSTGRES_USER:-postgres}}"
CMD ["postgres"]
