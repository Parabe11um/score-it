# Caddy 2.11.7's upstream go.mod still uses x/net 0.59.0. Rebuild the binary;
# upgrading Alpine alone cannot fix dependencies embedded in a Go executable.
ARG GO_IMAGE=golang:1.26.9-alpine3.24@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade
ARG CADDY_IMAGE=caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
FROM ${GO_IMAGE} AS builder
ENV GOTOOLCHAIN=local CGO_ENABLED=0
RUN apk add --no-cache git
WORKDIR /src
RUN git init \
    && git remote add origin https://github.com/caddyserver/caddy.git \
    && git fetch --depth 1 origin 72dd0fb067f6d7826c7f79907670ba4a713bfe37 \
    && git checkout --detach FETCH_HEAD \
    && go get golang.org/x/net@v0.60.0 \
    && go mod verify \
    && go build -trimpath -ldflags '-s -w -X github.com/caddyserver/caddy/v2.CustomVersion=v2.11.7-scoreit.1' -o /out/caddy ./cmd/caddy \
    && go version -m /out/caddy

FROM ${CADDY_IMAGE}
RUN apk upgrade --no-cache
COPY --from=builder /out/caddy /usr/bin/caddy
