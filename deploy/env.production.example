SCORE_IT_IMAGE=score-it:RELEASE
# PostgreSQL 17; use the exact image supplied in the release bundle.
POSTGRES_IMAGE=postgres:17-bookworm
POSTGRES_DB=score_it
POSTGRES_USER=score_it
POSTGRES_PASSWORD=

# For the migration, retain the existing Django key; do not put it in the image.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=score-it.devtestenv.ru,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://score-it.devtestenv.ru
DJANGO_TIME_ZONE=Europe/Moscow
WEB_WORKERS=2
WEB_THREADS=2
SCORE_IT_PROXY_NETWORK=score_it_proxy
