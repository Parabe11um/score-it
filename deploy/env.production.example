SCORE_IT_IMAGE=score-it:RELEASE
# PostgreSQL 17; use the exact image supplied in the release bundle.
POSTGRES_IMAGE=postgres:17-bookworm
POSTGRES_DB=score_it
# Existing installations MUST keep their actual admin/database name here.
POSTGRES_USER=score_it_admin
POSTGRES_PASSWORD=
DB_USER=score_it_app
DB_PASSWORD=
DB_MIGRATION_USER=score_it_migrate
DB_MIGRATION_PASSWORD=

# For the migration, retain the existing Django key; do not put it in the image.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=score-it.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://score-it.example.com
DJANGO_TIME_ZONE=Europe/Moscow
WEB_WORKERS=2
WEB_THREADS=2
SCORE_IT_PROXY_NETWORK=score_it_proxy
