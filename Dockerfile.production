ARG PYTHON_IMAGE=python:3.12.15-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
FROM ${PYTHON_IMAGE} AS tools-builder
ARG BUILD_TLS_COMPAT=0
RUN --mount=type=bind,source=deploy/build_tls.sh,target=/run/score-it-build-tls.sh,readonly \
    --mount=type=bind,source=deploy/build_runtime_noacl.sh,target=/run/score-it-build-noacl.sh,readonly \
    --mount=type=bind,source=deploy/acl_tools_sources.sha256,target=/run/score-it-acl-sources.sha256,readonly \
    --mount=type=bind,source=deploy/runtime_tools_probe.sh,target=/run/score-it-noacl-probe.sh,readonly \
    sh /run/score-it-build-tls.sh "$BUILD_TLS_COMPAT" sh /run/score-it-build-noacl.sh

FROM ${PYTHON_IMAGE} AS perl-builder
ARG BUILD_TLS_COMPAT=0
RUN --mount=type=bind,source=deploy/build_tls.sh,target=/run/score-it-build-tls.sh,readonly \
    --mount=type=bind,source=deploy/build_perl_regex_app.sh,target=/run/score-it-build-perl.sh,readonly \
    --mount=type=bind,source=deploy/patches/perl,target=/run/score-it-perl-patches,readonly \
    --mount=type=bind,source=deploy/perl_regex_build.sh,target=/run/score-it-perl-regex-build.sh,readonly \
    --mount=type=bind,source=deploy/perl_regex_cache_probe.py,target=/run/score-it-perl-regex-cache.py,readonly \
    --mount=type=bind,source=deploy/perl_regex_runtime_probe.pl,target=/run/score-it-perl-regex-runtime.pl,readonly \
    --mount=type=bind,source=deploy/perl_regex_sources.json,target=/run/score-it-perl-regex-sources.json,readonly \
    sh /run/score-it-build-tls.sh "$BUILD_TLS_COMPAT" sh /run/score-it-build-perl.sh

FROM ${PYTHON_IMAGE} AS gzip-builder
ARG BUILD_TLS_COMPAT=0
RUN --mount=type=bind,source=deploy/build_tls.sh,target=/run/score-it-build-tls.sh,readonly \
    --mount=type=bind,source=deploy/build_gzip_security.sh,target=/run/score-it-build-gzip.sh,readonly \
    --mount=type=bind,source=deploy/patches/gzip/e7378c2-lzh-state.patch,target=/run/score-it-gzip-followup.patch,readonly \
    --mount=type=bind,source=deploy/gzip_lzh_state_probe.c,target=/run/score-it-gzip-probe.c,readonly \
    sh /run/score-it-build-tls.sh "$BUILD_TLS_COMPAT" sh /run/score-it-build-gzip.sh

FROM ${PYTHON_IMAGE} AS runtime-files
ARG BUILD_TLS_COMPAT=0
RUN --mount=type=bind,source=deploy/build_tls.sh,target=/run/score-it-build-tls.sh,readonly \
    --mount=type=bind,source=deploy/update_app_security.sh,target=/run/score-it-update-app.sh,readonly \
    sh /run/score-it-build-tls.sh "$BUILD_TLS_COMPAT" sh /run/score-it-update-app.sh
RUN --mount=type=bind,from=perl-builder,source=/out,target=/run/score-it-perl,readonly \
    dpkg -i /run/score-it-perl/perl-base_5.40.1-6+deb13u1+scoreit1_amd64.deb
COPY --from=perl-builder /out/perl-regex-build.json /usr/share/score-it/
RUN --mount=type=bind,from=gzip-builder,source=/out,target=/run/score-it-gzip,readonly \
    dpkg -i /run/score-it-gzip/gzip_1.13-1+deb13u1+scoreit13.1_amd64.deb
COPY --from=gzip-builder /out/gzip-*.txt /out/gzip-binary.sha256 /usr/share/score-it/
RUN --mount=type=bind,from=tools-builder,source=/out,target=/run/score-it-tools,readonly \
    dpkg -i /run/score-it-tools/coreutils_9.7-3+~scoreitnoacl1_amd64.deb \
            /run/score-it-tools/sed_4.9-2+deb13u1+~scoreitnoacl1_amd64.deb \
            /run/score-it-tools/tar_1.35+dfsg-3.1+~scoreitnoacl1_amd64.deb
COPY --from=tools-builder /out/acl-tools-*.txt /out/acl-tools-binaries.sha256 /usr/share/score-it/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.bootstrap.txt requirements.production.txt /app/
RUN python -m pip install --no-cache-dir --require-hashes -r requirements.bootstrap.txt \
    && python -m pip install --no-cache-dir --require-hashes -r requirements.production.txt \
    && python -m pip check \
    && python -m pip uninstall --yes pip \
    && rm requirements.bootstrap.txt requirements.production.txt \
    && rm -rf /usr/local/lib/python3.12/ensurepip \
    && useradd --uid 10001 --create-home app
# Only application code and runtime/maintenance entry points belong in the image.
# Tests and docs stay in Git; audit tools are supplied by the build/test host.
COPY manage.py /app/
COPY config /app/config/
COPY poker /app/poker/
COPY static /app/static/
COPY templates /app/templates/
COPY deploy/configure_db_roles.py deploy/gunicorn.conf.py deploy/gunicorn_logger.py /app/deploy/
# This is a build-time key only; the runtime key must be supplied separately.
RUN DJANGO_SECRET_KEY=build-only-static-files DJANGO_DEBUG=0 DB_ENGINE=sqlite \
    DATABASE_PATH=/tmp/build.sqlite3 python manage.py collectstatic --noinput --no-post-process \
    && mkdir -p /app/data \
    && chown app:app /app/data
RUN --mount=type=bind,source=deploy/prune_runtime_sqlite.sh,target=/run/score-it-prune-sqlite.sh,readonly \
    sh /run/score-it-prune-sqlite.sh app
RUN --mount=type=bind,source=deploy/prune_runtime_tools.sh,target=/run/score-it-prune-tools.sh,readonly \
    sh /run/score-it-prune-tools.sh app

# Do not deliver the SQLite library/modules from earlier Python image layers.
FROM scratch
COPY --from=runtime-files / /
RUN chown 10001:10001 /app/data
ENV PATH=/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 \
    GPG_KEY=7169605F62C751356D054A26A821E680E5FA6305 \
    PYTHON_VERSION=3.12.15 \
    PYTHON_SHA256=c2c4321961fab0fb999d66e0cecf521c2ab3994c7992873ea99e306c1094fd5a \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SCORE_IT_REQUIRE_POSTGRESQL=1 \
    DB_ENGINE=postgresql
WORKDIR /app
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=7s --start-period=20s --retries=5 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz/', timeout=5).read()"]
CMD ["gunicorn", "--config", "deploy/gunicorn.conf.py", "config.wsgi:application"]
