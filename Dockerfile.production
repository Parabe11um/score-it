ARG PYTHON_IMAGE=python:3.12.15-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
FROM ${PYTHON_IMAGE} AS runtime-files
ARG BUILD_TLS_COMPAT=0
RUN --mount=type=bind,source=deploy/build_tls.sh,target=/run/score-it-build-tls.sh,readonly \
    --mount=type=bind,source=deploy/update_app_security.sh,target=/run/score-it-update-app.sh,readonly \
    sh /run/score-it-build-tls.sh "$BUILD_TLS_COMPAT" sh /run/score-it-update-app.sh

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.bootstrap.txt requirements.production.txt /app/
RUN python -m pip install --no-cache-dir --require-hashes -r requirements.bootstrap.txt \
    && python -m pip install --no-cache-dir --require-hashes -r requirements.production.txt \
    && python -m pip check \
    && python -m pip uninstall --yes pip \
    && rm requirements.bootstrap.txt requirements.production.txt \
    && rm -rf /usr/local/lib/python3.12/ensurepip \
    && useradd --uid 10001 --create-home app
# Only application code and runtime/maintenance entry points belong in the image.
# Tests and docs stay in Git; audit tools are supplied by the build/test host.
COPY manage.py /app/
COPY config /app/config/
COPY poker /app/poker/
COPY static /app/static/
COPY templates /app/templates/
COPY deploy/configure_db_roles.py deploy/gunicorn.conf.py deploy/gunicorn_logger.py /app/deploy/
# This is a build-time key only; the runtime key must be supplied separately.
RUN DJANGO_SECRET_KEY=build-only-static-files DJANGO_DEBUG=0 DB_ENGINE=sqlite \
    DATABASE_PATH=/tmp/build.sqlite3 python manage.py collectstatic --noinput --no-post-process \
    && mkdir -p /app/data \
    && chown app:app /app/data
RUN --mount=type=bind,source=deploy/prune_runtime_sqlite.sh,target=/run/score-it-prune-sqlite.sh,readonly \
    sh /run/score-it-prune-sqlite.sh app
RUN --mount=type=bind,source=deploy/prune_runtime_tools.sh,target=/run/score-it-prune-tools.sh,readonly \
    sh /run/score-it-prune-tools.sh app

# Do not deliver the SQLite library/modules from earlier Python image layers.
FROM scratch
COPY --from=runtime-files / /
RUN chown 10001:10001 /app/data
ENV PATH=/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 \
    GPG_KEY=7169605F62C751356D054A26A821E680E5FA6305 \
    PYTHON_VERSION=3.12.15 \
    PYTHON_SHA256=c2c4321961fab0fb999d66e0cecf521c2ab3994c7992873ea99e306c1094fd5a \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SCORE_IT_REQUIRE_POSTGRESQL=1 \
    DB_ENGINE=postgresql
WORKDIR /app
USER 10001:10001
EXPOSE 8000
CMD ["gunicorn", "--config", "deploy/gunicorn.conf.py", "config.wsgi:application"]
